---
import Layout from '../layouts/Layout.astro';

// KST 기준 오늘 날짜 계산
const now = new Date();
const kstOffset = 9 * 60; // UTC+9
const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
const kstDate = new Date(utc + (kstOffset * 60000));

const month = kstDate.getMonth() + 1;
const day = kstDate.getDate();
const year = kstDate.getFullYear();

const formattedToday = `${month}월 ${day}일`;
const formattedFull = `${year}년 ${month}월 ${day}일`;

// 임시 샘플 밈 데이터
const sampleMeme = {
  date: "9월 1일",
  title: "9월 1일 요크신시티에서",
  quote: "9월 1일 요크신시티에서 만나자.",
  origin: "헌터x헌터 (Hunter x Hunter)",
  desc: "만화 '헌터x헌터'에서 크라피카와 환영여단이 집결하기로 약속한 운명의 날짜. 매년 9월 1일이 되면 덕후 커뮤니티에 자동 소환되는 대표 밈입니다.",
  tags: ["헌터헌터", "크라피카", "환영여단", "9월1일", "요크신시티"],
  fileName: "2000-09-01_yorknew-city.jpg"
};
---

<Layout title={`오늘의 밈 (${formattedToday}) | Meme of the Day`}>
	<main class="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
		<!-- Header -->
		<header class="text-center space-y-4 mb-12">
			<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold tracking-wide uppercase">
				<span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
				Cloudflare Pages 배포 테스트 준비 완료
			</div>
			
			<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-transparent">
				Meme of the Day 📅
			</h1>
			<p class="text-zinc-400 text-lg max-w-xl mx-auto">
				"오늘 무슨 밈의 날인지 알아?"<br />
				날짜가 있는 인터넷 전설의 밈들을 수집하고 검색하세요.
			</p>
		</header>

		<!-- Today's Date Banner -->
		<div class="relative overflow-hidden rounded-2xl bg-zinc-900/80 border border-zinc-800 p-6 sm:p-8 mb-8 shadow-2xl backdrop-blur-xl">
			<div class="absolute -top-24 -right-24 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute -bottom-24 -left-24 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

			<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-zinc-800/80">
				<div>
					<span class="text-xs font-bold uppercase tracking-wider text-indigo-400">TODAY'S DATE</span>
					<div class="text-2xl sm:text-3xl font-black text-white flex items-center gap-3 mt-1">
						<span>{formattedToday}</span>
						<span class="text-xs font-normal text-zinc-400 px-2 py-0.5 rounded bg-zinc-800">{formattedFull} (KST)</span>
					</div>
				</div>

				<!-- Quick Date Navigation (UI Prototype) -->
				<div class="flex items-center gap-2">
					<button class="px-3 py-1.5 text-xs font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg transition-colors border border-zinc-700/50">
						← 어제 밈
					</button>
					<button class="px-3 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors font-semibold shadow-lg shadow-indigo-500/20">
						오늘
					</button>
					<button class="px-3 py-1.5 text-xs font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg transition-colors border border-zinc-700/50">
						내일 밈 →
					</button>
				</div>
			</div>

			<!-- Search Bar Placeholder -->
			<div class="mt-6">
				<div class="relative">
					<input 
						type="text" 
						placeholder="날짜(예: 9월 1일, 09-01) 또는 키워드(요크신, 만우절)로 검색..."
						class="w-full bg-zinc-950/80 border border-zinc-700/60 rounded-xl px-4 py-3 pl-11 text-sm text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
					/>
					<svg class="w-5 h-5 absolute left-3.5 top-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
				</div>
			</div>
		</div>

		<!-- Featured Meme Preview Card -->
		<section class="space-y-4">
			<div class="flex items-center justify-between">
				<h2 class="text-xl font-bold text-zinc-200 flex items-center gap-2">
					<span>✨ 대표 밈 미리보기 예시</span>
				</h2>
				<span class="text-xs text-zinc-500 font-mono">data/media/{sampleMeme.fileName}</span>
			</div>

			<div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl overflow-hidden hover:border-zinc-700 transition-all group">
				<!-- Media Area Placeholder -->
				<div class="aspect-video w-full bg-gradient-to-br from-zinc-800 to-zinc-950 flex flex-col items-center justify-center p-8 text-center relative border-b border-zinc-800">
					<div class="w-16 h-16 rounded-2xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 mb-3 shadow-inner">
						<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
						</svg>
					</div>
					<div class="text-lg font-bold text-zinc-200">"{sampleMeme.quote}"</div>
					<p class="text-xs text-zinc-500 mt-1">미디어 파일: <code>{sampleMeme.fileName}</code></p>
				</div>

				<!-- Content Area -->
				<div class="p-6 space-y-4">
					<div>
						<div class="flex items-center gap-2 text-xs font-semibold text-indigo-400 mb-1">
							<span>📅 {sampleMeme.date}</span>
							<span>•</span>
							<span>출처: {sampleMeme.origin}</span>
						</div>
						<h3 class="text-2xl font-bold text-white group-hover:text-indigo-300 transition-colors">
							{sampleMeme.title}
						</h3>
					</div>

					<p class="text-zinc-400 text-sm leading-relaxed">
						{sampleMeme.desc}
					</p>

					<!-- Tags -->
					<div class="flex flex-wrap gap-2 pt-2">
						{sampleMeme.tags.map(tag => (
							<span class="text-xs px-2.5 py-1 rounded-md bg-zinc-800/80 text-zinc-300 border border-zinc-700/50 hover:border-indigo-500/50 hover:text-indigo-300 transition-colors cursor-pointer">
								#{tag}
							</span>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Cloudflare Pages Deployment Guide -->
		<section class="mt-12 p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800 text-xs text-zinc-400 space-y-3">
			<div class="flex items-center gap-2 text-zinc-200 font-bold text-sm">
				<span>⚡ Cloudflare Pages 배포 설정 안내</span>
			</div>
			<ul class="space-y-1.5 list-disc list-inside text-zinc-400">
				<li><strong class="text-zinc-200">Framework preset:</strong> <code>Astro</code></li>
				<li><strong class="text-zinc-200">Build command:</strong> <code>npm run build</code></li>
				<li><strong class="text-zinc-200">Build output directory:</strong> <code>dist</code></li>
			</ul>
		</section>
	</main>
</Layout>
