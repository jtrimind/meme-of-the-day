---
import type { MemeItem } from '../lib/memes';

interface Props {
  memes: MemeItem[];
  currentMonth: number;
  currentDay: number;
  currentYear: number;
}

const { memes, currentMonth, currentDay, currentYear } = Astro.props;
---

<div class="calendar-container bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 sm:p-6 shadow-2xl backdrop-blur-xl space-y-6">
  <!-- Calendar Header & Controls -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-4 border-b border-zinc-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      <div>
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <span>📅 365 밈 캘린더</span>
        </h2>
        <p class="text-xs text-zinc-400">날짜를 클릭하여 그 날의 밈을 확인하세요</p>
      </div>
    </div>

    <!-- Month Navigation -->
    <div class="flex items-center gap-2">
      <button 
        id="cal-prev-month"
        class="p-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors border border-zinc-700/50"
        title="이전 달"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <span id="cal-month-display" class="text-base sm:text-lg font-bold text-white px-3 py-1 min-w-[100px] text-center font-mono">
        {currentMonth}월
      </span>

      <button 
        id="cal-next-month"
        class="p-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors border border-zinc-700/50"
        title="다음 달"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <button 
        id="cal-today-btn"
        class="ml-2 px-3 py-1.5 text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors shadow-sm"
      >
        오늘({currentMonth}월 {currentDay}일)
      </button>
    </div>
  </div>

  <!-- Weekday Labels -->
  <div class="grid grid-cols-7 gap-1 sm:gap-2 text-center text-xs font-bold text-zinc-400">
    <div class="text-rose-400 py-1">일</div>
    <div class="py-1">월</div>
    <div class="py-1">화</div>
    <div class="py-1">수</div>
    <div class="py-1">목</div>
    <div class="py-1">금</div>
    <div class="text-sky-400 py-1">토</div>
  </div>

  <!-- Calendar Days Grid -->
  <div id="cal-days-grid" class="grid grid-cols-7 gap-1 sm:gap-2">
    <!-- Rendered dynamically by client script -->
  </div>

  <!-- Selected Meme Detail Drawer / Modal -->
  <div id="cal-preview-card" class="hidden p-4 sm:p-6 rounded-xl bg-zinc-950/80 border border-indigo-500/30 space-y-4 animate-in fade-in duration-200">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span id="cal-preview-badge" class="px-2.5 py-0.5 rounded-md bg-indigo-500/20 text-indigo-300 text-xs font-bold border border-indigo-500/30">
          날짜
        </span>
        <h4 id="cal-preview-title" class="text-lg sm:text-xl font-bold text-white">제목</h4>
      </div>
      <button id="cal-preview-close" class="text-xs text-zinc-500 hover:text-zinc-300 px-2 py-1 rounded bg-zinc-800">닫기 ✕</button>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 items-start">
      <div class="w-full sm:w-64 aspect-video bg-zinc-900 rounded-lg overflow-hidden flex items-center justify-center border border-zinc-800 flex-shrink-0 relative">
        <img id="cal-preview-img" src="" alt="" class="w-full h-full object-cover" />
        <video id="cal-preview-video" src="" controls autoplay muted loop playsinline class="w-full h-full object-cover hidden"></video>
      </div>
      <div class="space-y-2 flex-1">
        <p id="cal-preview-desc" class="text-xs sm:text-sm text-zinc-300 leading-relaxed"></p>
        <div id="cal-preview-tags" class="flex flex-wrap gap-1.5 pt-2"></div>
        <div class="pt-2">
          <a id="cal-preview-link" href="#" target="_blank" class="inline-flex items-center gap-1 text-xs text-indigo-400 hover:text-indigo-300 font-semibold">
            원본 고화질 보기 ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script id="calendar-memes-data" type="application/json" set:html={JSON.stringify(memes).replace(/</g, '\\u003c')} />

<script>
  import { getTodayKST, type MemeItem } from '../lib/meme-utils';

  const dataEl = document.getElementById('calendar-memes-data') || document.getElementById('memes-data');
  const memesData: MemeItem[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const { year: kstYear, month: kstMonth, day: kstDay } = getTodayKST();

  let activeMonth = kstMonth;
  let activeYear = kstYear;

  const monthDisplay = document.getElementById('cal-month-display');
  const daysGrid = document.getElementById('cal-days-grid');
  const prevBtn = document.getElementById('cal-prev-month');
  const nextBtn = document.getElementById('cal-next-month');
  const todayBtn = document.getElementById('cal-today-btn');

  if (todayBtn) {
    todayBtn.textContent = `오늘(${kstMonth}월 ${kstDay}일)`;
  }

  const previewCard = document.getElementById('cal-preview-card');
  const previewBadge = document.getElementById('cal-preview-badge');
  const previewTitle = document.getElementById('cal-preview-title');
  const previewImg = document.getElementById('cal-preview-img') as HTMLImageElement | null;
  const previewVideo = document.getElementById('cal-preview-video') as HTMLVideoElement | null;
  const previewDesc = document.getElementById('cal-preview-desc');
  const previewTags = document.getElementById('cal-preview-tags');
  const previewLink = document.getElementById('cal-preview-link') as HTMLAnchorElement | null;
  const previewClose = document.getElementById('cal-preview-close');

  previewClose?.addEventListener('click', () => {
    previewCard?.classList.add('hidden');
    if (previewVideo) {
      previewVideo.pause();
    }
  });

  function renderCalendar(month: number) {
    if (!daysGrid || !monthDisplay) return;

    monthDisplay.textContent = `${month}월`;

    const firstDayOfWeek = new Date(activeYear, month - 1, 1).getDay(); // 0 (일) ~ 6 (토)
    const daysInMonth = new Date(activeYear, month, 0).getDate();

    daysGrid.innerHTML = '';

    // 이전 달 빈 칸
    for (let i = 0; i < firstDayOfWeek; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'aspect-square sm:aspect-[4/5] rounded-xl bg-zinc-950/20 border border-transparent p-1 opacity-20';
      daysGrid.appendChild(emptyCell);
    }

    // 이번 달 날짜들
    for (let day = 1; day <= daysInMonth; day++) {
      const cell = document.createElement('div');
      const dayMemes = memesData.filter(m => (m.date.month === null || m.date.month === month) && m.date.day === day);
      const isToday = activeYear === kstYear && month === kstMonth && day === kstDay;
      const hasMeme = dayMemes.length > 0;

      let cellClass = 'relative aspect-square sm:aspect-[4/5] rounded-xl border p-1 sm:p-2 flex flex-col justify-between transition-all cursor-pointer select-none group ';

      if (isToday) {
        cellClass += 'bg-indigo-950/40 border-indigo-500/80 shadow-md shadow-indigo-500/10 ';
      } else if (hasMeme) {
        cellClass += 'bg-zinc-800/80 border-indigo-500/40 hover:border-indigo-400 hover:bg-zinc-800 ';
      } else {
        cellClass += 'bg-zinc-950/40 border-zinc-800/60 hover:border-zinc-700 hover:bg-zinc-900/60 ';
      }

      cell.className = cellClass;

      // 상단: 날짜 번호 및 오늘 배지
      const topBar = document.createElement('div');
      topBar.className = 'flex items-center justify-between w-full';

      const dateNum = document.createElement('span');
      dateNum.className = `text-xs sm:text-sm font-black ${isToday ? 'text-indigo-400' : hasMeme ? 'text-white' : 'text-zinc-400 group-hover:text-zinc-200'}`;
      dateNum.textContent = day;
      topBar.appendChild(dateNum);

      if (isToday) {
        const todayDot = document.createElement('span');
        todayDot.className = 'text-[9px] bg-indigo-500 text-white font-bold px-1.5 py-0.2 rounded-full';
        todayDot.textContent = '오늘';
        topBar.appendChild(todayDot);
      } else if (hasMeme) {
        const memeDot = document.createElement('span');
        memeDot.className = 'w-2 h-2 rounded-full bg-indigo-400 animate-pulse';
        topBar.appendChild(memeDot);
      }

      cell.appendChild(topBar);

      // 중앙: 밈 썸네일 또는 미니 프리뷰
      if (hasMeme) {
        const meme = dayMemes[0];
        const thumbWrap = document.createElement('div');
        thumbWrap.className = 'mt-1 w-full h-8 sm:h-12 rounded-lg overflow-hidden border border-zinc-700/80 relative bg-zinc-900 flex items-center justify-center';

        if (meme.media.type === 'video') {
          const video = document.createElement('video');
          video.src = meme.media.url;
          video.autoplay = true;
          video.loop = true;
          video.muted = true;
          video.playsInline = true;
          video.className = 'w-full h-full object-cover group-hover:scale-110 transition-transform duration-200 pointer-events-none';
          thumbWrap.appendChild(video);

          const videoBadge = document.createElement('span');
          videoBadge.className = 'absolute bottom-0.5 right-0.5 text-[8px] bg-black/80 text-indigo-300 font-bold px-1 rounded pointer-events-none';
          videoBadge.textContent = '▶';
          thumbWrap.appendChild(videoBadge);
        } else {
          const img = document.createElement('img');
          img.src = meme.media.url;
          img.alt = meme.title;
          img.className = 'w-full h-full object-cover group-hover:scale-110 transition-transform duration-200';
          img.loading = 'lazy';
          thumbWrap.appendChild(img);
        }

        cell.appendChild(thumbWrap);

        // 하단 슬러그/타이틀 (모바일은 숨김)
        const label = document.createElement('span');
        label.className = 'hidden sm:block text-[10px] text-zinc-300 font-medium truncate w-full mt-1';
        label.textContent = meme.title;
        cell.appendChild(label);
      } else {
        const emptyHolder = document.createElement('div');
        emptyHolder.className = 'flex-1';
        cell.appendChild(emptyHolder);
      }

      // 클릭 이벤트
      cell.addEventListener('click', () => {
        if (hasMeme) {
          showMemePreview(dayMemes[0]);
        } else {
          // 밈이 없는 경우 안내
          previewCard?.classList.remove('hidden');
          if (previewBadge) previewBadge.textContent = `${month}월 ${day}일`;
          if (previewTitle) previewTitle.textContent = '등록된 밈이 없습니다';
          if (previewVideo) {
            previewVideo.pause();
            previewVideo.classList.add('hidden');
          }
          if (previewImg) {
            previewImg.classList.remove('hidden');
            previewImg.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="150" viewBox="0 0 200 150"><rect fill="%2318181b" width="200" height="150"/><text fill="%2371717a" font-size="12" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle">No Meme Yet</text></svg>';
          }
          if (previewDesc) previewDesc.textContent = `이 날짜(${month}월 ${day}일)에 해당하는 밈 파일을 data/media/ 폴더에 추가해 보세요! (예: xxxx-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}_name.png)`;
          if (previewTags) previewTags.innerHTML = '';
          if (previewLink) previewLink.style.display = 'none';
          previewCard?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });

      daysGrid.appendChild(cell);
    }
  }

  function showMemePreview(meme: MemeItem) {
    if (!previewCard) return;
    previewCard.classList.remove('hidden');

    if (previewBadge) previewBadge.textContent = meme.formattedDate;
    if (previewTitle) previewTitle.textContent = meme.title;

    if (meme.media.type === 'video') {
      if (previewImg) previewImg.classList.add('hidden');
      if (previewVideo) {
        previewVideo.src = meme.media.url;
        previewVideo.classList.remove('hidden');
        previewVideo.play().catch(() => {});
      }
    } else {
      if (previewVideo) {
        previewVideo.pause();
        previewVideo.classList.add('hidden');
      }
      if (previewImg) {
        previewImg.src = meme.media.url;
        previewImg.alt = meme.title;
        previewImg.classList.remove('hidden');
      }
    }

    if (previewDesc) {
      previewDesc.textContent = meme.description || `${meme.title} - ${meme.formattedDate} 대표 밈 (파일명: ${meme.fileName})`;
    }
    if (previewLink) {
      previewLink.href = meme.media.url;
      previewLink.style.display = 'inline-flex';
    }
    if (previewTags) {
      previewTags.innerHTML = '';
      meme.tags.forEach((tag: string) => {
        const tagSpan = document.createElement('span');
        tagSpan.className = 'text-[11px] px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-zinc-700/60';
        tagSpan.textContent = `#${tag}`;
        previewTags.appendChild(tagSpan);
      });
    }

    previewCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  prevBtn?.addEventListener('click', () => {
    if (activeMonth === 1) {
      activeMonth = 12;
      activeYear--;
    } else {
      activeMonth--;
    }
    renderCalendar(activeMonth);
  });

  nextBtn?.addEventListener('click', () => {
    if (activeMonth === 12) {
      activeMonth = 1;
      activeYear++;
    } else {
      activeMonth++;
    }
    renderCalendar(activeMonth);
  });

  todayBtn?.addEventListener('click', () => {
    activeMonth = kstMonth;
    activeYear = kstYear;
    renderCalendar(activeMonth);
  });

  // 초기 렌더링
  renderCalendar(activeMonth);
</script>
